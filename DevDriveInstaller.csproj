<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows10.0.22621.0</TargetFramework>
    <TargetPlatformMinVersion>10.0.22621.0</TargetPlatformMinVersion>
    <RootNamespace>DevDriveInstaller</RootNamespace>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>Assets\AppIcon.ico</ApplicationIcon>
    <Title>Dev Drive installer</Title>
    <Product>Dev Drive installer</Product>
    <UseWinUI>true</UseWinUI>
    <WindowsPackageType>None</WindowsPackageType>
    <WindowsAppSDKSelfContained>true</WindowsAppSDKSelfContained>
    <WindowsAppSDKDeploymentManagerInitialize>false</WindowsAppSDKDeploymentManagerInitialize>
    <SelfContained>true</SelfContained>
    <RuntimeIdentifiers>win-arm64;win-x64</RuntimeIdentifiers>
    <Platforms>ARM64;x64</Platforms>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.WindowsAppSDK" Version="1.8.260317003" />
    <PackageReference Include="Microsoft.Windows.SDK.BuildTools" Version="10.0.26100.7175" />
    <EmbeddedResource Include="StorageBackend.ps1" LogicalName="StorageBackend" />
    <EmbeddedResource Include="VolumeProbe.cs" LogicalName="VolumeProbe" />
    <Compile Remove="VolumeProbe.cs" />
    <Compile Remove="tests\**\*.cs" />
    <None Remove="Assets\AppIcon.ico" />
    <Content Include="Assets\AppIcon.ico" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
  </ItemGroup>
  <Target Name="IncludeAppXamlResourcesInPublish" AfterTargets="ComputeFilesToPublish">
    <ItemGroup>
      <_AppXamlResources Include="$(TargetDir)App.xbf;$(TargetDir)MainWindow.xbf;$(TargetDir)$(AssemblyName).pri" />
    </ItemGroup>
    <Error Condition="!Exists('%(_AppXamlResources.Identity)')" Text="Required compiled WinUI resource is missing: %(_AppXamlResources.Identity)" />
    <ItemGroup>
      <ResolvedFileToPublish Include="@(_AppXamlResources)">
        <RelativePath>%(Filename)%(Extension)</RelativePath>
        <CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
      </ResolvedFileToPublish>
    </ItemGroup>
  </Target>
</Project>

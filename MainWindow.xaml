<Window
    x:Class="DevDriveInstaller.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid x:Name="Root" Padding="16" RowSpacing="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <Grid ColumnSpacing="12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <Border Background="#005FB8" CornerRadius="10" Width="44" Height="44">
                <PathIcon Foreground="White"
                    Data="M2,3 L22,3 L22,10 L2,10 Z M2,14 L22,14 L22,21 L2,21 Z M5,6 L12,6 M5,17 L12,17" />
            </Border>
            <TextBlock Grid.Column="1" Text="Dev Drive installer"
                Style="{ThemeResource TitleTextBlockStyle}" VerticalAlignment="Center" />
            <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="8">
                <Button x:Name="RefreshButton" Content="Refresh" Click="Refresh_Click" />
                <Button x:Name="HelpButton" Content="Help" Click="Help_Click" />
            </StackPanel>
        </Grid>
        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
            <StackPanel Spacing="10">
                <InfoBar x:Name="StatusBar" IsOpen="True" IsClosable="False"
                    Severity="Informational" Title="Loading drives" />
                <Grid ColumnSpacing="12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="Drives" Style="{ThemeResource SubtitleTextBlockStyle}"
                        ToolTipService.ToolTip="Only drives with letters are shown here. All connected volumes are still checked for safety." />
                    <TextBlock x:Name="PoolText" Grid.Column="1" VerticalAlignment="Center">
                        <ToolTipService.ToolTip>
                            <ToolTip Content="Physical pool capacity is shared by the thin Windows and Dev spaces. Drive free space is not reserved capacity." />
                        </ToolTipService.ToolTip>
                    </TextBlock>
                </Grid>
                <ProgressBar x:Name="AllocationBar" Maximum="100" Height="8" />
                <ScrollViewer x:Name="DrivesViewport" SizeChanged="Drives_SizeChanged"
                    VerticalScrollBarVisibility="Disabled" VerticalScrollMode="Disabled"
                    HorizontalScrollBarVisibility="Auto" HorizontalScrollMode="Enabled">
                    <ItemsControl x:Name="VolumesList">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <StackPanel Orientation="Horizontal" />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Width="{Binding DisplayWidth}" Height="132" BorderThickness="1" Margin="0,0,10,0"
                                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                    Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                                    ToolTipService.ToolTip="{Binding Capacity}">
                                    <Grid>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="*" />
                                        </Grid.RowDefinitions>
                                        <Border Background="#005FB8" Height="8" Loaded="DriveBand_Loaded" />
                                        <StackPanel Grid.Row="1" Spacing="6" Margin="12">
                                            <TextBlock Text="{Binding Heading}" FontWeight="SemiBold"
                                                MaxLines="1" TextTrimming="CharacterEllipsis"
                                                ToolTipService.ToolTip="{Binding Heading}" />
                                            <TextBlock Text="{Binding SizeText}" FontSize="12" />
                                            <TextBlock Text="{Binding Status}" FontSize="12" MaxLines="1"
                                                TextTrimming="CharacterEllipsis" Opacity="0.8"
                                                ToolTipService.ToolTip="{Binding Status}" />
                                            <ProgressBar Value="{Binding UsedPercent}" Maximum="100" Height="8" />
                                        </StackPanel>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
                <Border Height="1" Margin="0,8" Background="{ThemeResource DividerStrokeColorDefaultBrush}" />
                <TextBlock Text="Create Dev Drive" Style="{ThemeResource SubtitleTextBlockStyle}" />
                <Grid ColumnSpacing="16">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="240" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <NumberBox x:Name="SizeBox" Header="Size (GiB)" SpinButtonPlacementMode="Inline"
                        SmallChange="25" LargeChange="100" ValueChanged="Size_ValueChanged"
                        ToolTipService.ToolTip="Choose a whole number within the safe range. Help explains shared capacity and headroom." />
                    <TextBlock x:Name="SizeHintText" Grid.Column="1" TextWrapping="Wrap" VerticalAlignment="Center" />
                </Grid>
                <Grid ColumnSpacing="12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Button x:Name="CreateButton" Content="Create Dev Drive" IsEnabled="False"
                        Style="{StaticResource AccentButtonStyle}" Click="Create_Click" />
                    <Button x:Name="RemoveButton" Grid.Column="1" Content="Remove Dev Drive"
                        Visibility="Collapsed" IsEnabled="False" Click="Remove_Click" />
                    <ProgressRing x:Name="BusyRing" Grid.Column="2" Width="24" Height="24"
                        IsActive="False" Visibility="Collapsed" AutomationProperties.Name="Working" />
                    <TextBlock x:Name="ActivityText" Grid.Column="3" VerticalAlignment="Center" TextWrapping="Wrap" />
                </Grid>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</Window>
